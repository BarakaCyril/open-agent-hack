PORT=8000
SAMPLE_MODE=true
# For a Zetaris proxy published on host port 3000. Change this for your Docker mapping.
ZETARIS_REST_URL=http://127.0.0.1:3000/api/proxy
ZETARIS_API_KEY=replace-me
ZETARIS_ORG_ID=replace-me
# Optional: refresh a short-lived API key. Either pair works.
# Use a dedicated least-privilege account. Never commit your local .env.
ZETARIS_ADMIN_EMAIL=
ZETARIS_ADMIN_PASSWORD=
# ZETARIS_USERNAME=
# ZETARIS_PASSWORD=
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=replace-me
METERLESS_MODEL=meterless/auto
SOURCE_TIMEOUT_SECONDS=12
MAX_RETRIES=2
LOG_DIR=logs
STALE_DAYS=3
KAMIS_MAX_PAGES=2
KAMIS_PER_PAGE=100
# One-off history pull. npm run backfill:kamis stops after this many export pages.
BACKFILL_MAX_PAGES=40
ZETARIS_MAIZE_DIR=/home/zetaris/customer-data/shared/maize
# Set false to keep refresh tools off the network. A successful pull is reused for this many minutes.
REFRESH_ENABLED=true
REFRESH_TTL_MINUTES=360
# maize-db, the Postgres container Zetaris reads as datasource maize_pg.
# Host port 5433. Do not point this at the Zetaris metadata database.
MAIZE_PG_HOST=127.0.0.1
MAIZE_PG_PORT=5433
MAIZE_PG_USER=maize
MAIZE_PG_PASSWORD=
MAIZE_PG_DATABASE=maize

# Do not use the placeholder token rt-local. The Meterless adapter refuses it.
# From inside WSL, 127.0.0.1 may not reach Nightshift running on Windows; use the Windows host address if the connection fails.

# Reasoning provider: meterless or nvidia.
MODEL_PROVIDER=nvidia
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=replace-me
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
