PORT=8000
SAMPLE_MODE=true
ZETARIS_REST_URL=https://zetaris.example.com
ZETARIS_API_KEY=replace-me
ZETARIS_ORG_ID=replace-me
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=replace-me
METERLESS_MODEL=meterless/auto
SOURCE_TIMEOUT_SECONDS=12
MAX_RETRIES=2
LOG_DIR=logs
STALE_DAYS=3
KAMIS_MAX_PAGES=2
KAMIS_PER_PAGE=100
ZETARIS_MAIZE_DIR=/home/zetaris/customer-data/shared/maize

# Do not use the placeholder token rt-local. The Meterless adapter refuses it.
# From inside WSL, 127.0.0.1 may not reach Nightshift running on Windows; use the Windows host address if the connection fails.

# Reasoning provider: meterless or nvidia.
MODEL_PROVIDER=nvidia
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=replace-me
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
