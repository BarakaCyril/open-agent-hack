{
  "name": "open-agent-maize",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sell/hold decision support for a smallholder Kenyan white-maize farmer.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/run.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke_test.ts",
    "ui": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "trace": "tsx scripts/trace.ts",
    "refresh:weather": "tsx scripts/refresh_weather.ts",
    "refresh:kamis": "tsx scripts/refresh_kamis.ts",
    "load:sample": "tsx scripts/load_sample_into_zetaris.ts"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
